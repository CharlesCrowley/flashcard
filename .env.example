# Backend Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/flashcard_db
# Or for development with SQLite:
# DATABASE_URL=sqlite:./dev.db

# API Keys
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
DEEPL_API_KEY=your_deepl_api_key
MERRIAM_WEBSTER_API_KEY=your_mw_learners_api_key

# LLM Configuration (Llama 3.3 70b)
GROQ_API_KEY=your_groq_api_key
# or if using another provider:
# OPENROUTER_API_KEY=your_openrouter_api_key

# CORS
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string)
JWT_SECRET=your_jwt_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
