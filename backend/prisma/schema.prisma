// Prisma schema for ESL Flashcard App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // For development, you can use SQLite:
  // provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  l1        String   @default("es") // Native language code (ISO 639-1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decks       Deck[]
  reviews     Review[]
  studySessions StudySession[]

  @@map("users")
}

model Deck {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards Card[]

  @@map("decks")
}

model Card {
  id        String   @id @default(uuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  // Main content
  word          String
  definition    String
  pronunciation String?       // IPA or phonetic
  audioUrl      String?       // Audio file URL

  // Visual learning
  imageUrl      String?       // Unsplash or custom image
  drawingData   String?       // Canvas drawing data (JSON)

  // Context and examples
  exampleSentences String[]    // Array of example sentences
  translation      String?     // L1 translation

  // Metadata
  partOfSpeech  String?       // noun, verb, adjective, etc.
  tags          String[]      // For organization

  // FSRS scheduling data
  due           DateTime      @default(now())
  stability     Float         @default(0)
  difficulty    Float         @default(0)
  elapsedDays   Int           @default(0)
  scheduledDays Int           @default(0)
  reps          Int           @default(0)
  lapses        Int           @default(0)
  state         Int           @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  lastReview    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@index([deckId])
  @@index([due])
  @@map("cards")
}

model Review {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Review data
  rating      Int       // FSRS rating: 1=Again, 2=Hard, 3=Good, 4=Easy
  reviewedAt  DateTime  @default(now())

  // Performance tracking
  timeSpent   Int?      // Time in milliseconds

  @@index([cardId])
  @@index([userId])
  @@index([reviewedAt])
  @@map("reviews")
}

model StudySession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt  DateTime @default(now())
  endedAt    DateTime?
  cardsStudied Int     @default(0)
  duration   Int?     // Duration in seconds

  @@index([userId])
  @@map("study_sessions")
}
